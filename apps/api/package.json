{
  "name": "@sketchmind/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@sketchmind/agent-core": "workspace:*",
    "@sketchmind/agent-memory": "workspace:*",
    "@sketchmind/agent-vision": "workspace:*",
    "@sketchmind/agent-tools-geometry": "workspace:*",
    "@sketchmind/agent-tools-reasoning": "workspace:*",
    "@sketchmind/llm-provider": "workspace:*",
    "@sketchmind/llm-provider-anthropic": "workspace:*",
    "@sketchmind/llm-provider-azure-openai": "workspace:*",
    "@sketchmind/session-protocol": "workspace:*",
    "@sketchmind/shared-types": "workspace:*",
    "@sketchmind/stroke-runtime": "workspace:*",
    "fastify": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
