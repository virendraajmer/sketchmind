{
  "name": "@sketchmind/llm-provider",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/contract.d.ts",
      "default": "./dist/testing/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@sketchmind/shared-types": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "vitest": "^2.1.9"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
