# SketchMind environment contract.
# Copy to .env and fill in. .env is gitignored -- never commit real values.

# ---- Azure OpenAI (AI Foundry) ----
# Read ONLY by packages/llm-provider-azure-openai. No other package may
# read these, or import an Azure SDK (lint-enforced).
#
# This targets Azure's v1 API surface (GA since Aug 2025), which needs NO
# api-version and works with the stock `openai` client. Either spelling is
# accepted; a bare resource endpoint is normalized up to `/openai/v1/`.
#   https://<resource>.services.ai.azure.com/openai/v1
#   https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# Declared capabilities. Left unset, the adapter assumes a current model
# (structured output + tools + streaming). `pnpm probe:azure` verifies these
# against the live deployment -- capability is checked, never inferred from a
# model name, because a hardcoded model catalogue goes stale immediately.
AZURE_OPENAI_STRUCTURED_OUTPUT=
AZURE_OPENAI_TOOL_CALLING=
AZURE_OPENAI_MAX_CONTEXT_TOKENS=

# Optional: multimodal deployment for the VISUAL tier of self-correction
# (AD-3 / Phase 10b), where the agent looks at a rendered PNG of its own drawing.
#
# LEAVE BLANK. Blank is the supported default and costs nothing: self-correction
# still runs via the geometric tier (Phase 10a), which inspects the LayoutModel
# and StrokeAST as JSON -- deterministic, zero tokens, no added latency.
#
# Set this only when you decide the extra tokens and round-trip latency are worth
# catching what geometry inspection cannot ("this doesn't read as a pulley
# system"). Any deployment that accepts IMAGE INPUT works; the model only ever
# needs to output text.
#
# This flag is per-instance, not per-process: a provider instance only reports
# vision:true when it was actually constructed against THIS deployment. If
# AZURE_OPENAI_DEPLOYMENT names a different (text) deployment than this one,
# setting this variable alone enables nothing -- something upstream (the role
# resolver, Phase 10 Task 6) must also select this deployment for the vision
# role via a per-role model override. The single-provider default path
# (SKETCHMIND_LLM_PROVIDER, no role split) never does this automatically, so
# in that mode AZURE_OPENAI_DEPLOYMENT and this value should simply match.
AZURE_OPENAI_VISION_DEPLOYMENT=

# Auth: use EITHER an API key OR Entra ID (managed identity / DefaultAzureCredential).
# Prefer Entra ID in deployed environments; the key is a local-dev convenience.
# Entra needs the `Cognitive Services OpenAI User` role on your identity; the
# adapter requests the https://ai.azure.com/.default scope and refreshes tokens
# automatically. Never set both.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_USE_ENTRA_ID=false

# ---- Anthropic (alternate provider; proves the abstraction isn't Azure-shaped) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Provider selection ----
# Changing this value is the ONLY change required to swap LLM providers.
# Supported: azure-openai | anthropic
#
# Left BLANK, apps/api starts on a canned fake provider instead of refusing to
# boot -- a machine with no key should still run the UI and say why it cannot
# draw. Set it, and a missing adapter variable is a loud startup failure:
# silently falling back to a fake in production would be far worse.
SKETCHMIND_LLM_PROVIDER=azure-openai

# ---- Agent budgets ----
# These bound cost and liveness, never the agent's decisions (AD-8). The agent
# acts freely within them; they exist so a tool loop cannot run unbounded.
SKETCHMIND_AGENT_MAX_STEPS=40
SKETCHMIND_AGENT_MAX_TOKENS=200000
SKETCHMIND_AGENT_TIMEOUT_MS=180000

# ---- Servers ----
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origin allowed to open a session stream. The browser talks only to apps/api;
# it never reaches a model provider, which is why the keys above can stay here.
SKETCHMIND_WEB_ORIGIN=http://localhost:3000

# ---- Session runtime ----
# Where learned primitives persist between sessions (AD-7), relative to apps/api.
SKETCHMIND_MEMORY_PATH=.data/memory.json

# How often playback advances, in milliseconds. One tick is one streamed frame,
# so this trades bandwidth against smoothness. It is NOT a drawing-speed
# control -- stroke durations live in the Stroke AST.
SKETCHMIND_TICK_MS=50

# --- Vision self-correction (Phase 10, AD-3) ---
# Tier 1: deterministic geometric critique. Free, and on by default.
SKETCHMIND_GEOMETRIC_CRITIQUE=on
# Tier 2: image critique. off | auto | on.
#   auto = runs exactly when a vision-capable provider resolves.
SKETCHMIND_VISION_MODE=off
SKETCHMIND_VISION_MAX_ROUNDS=2
SKETCHMIND_VISION_MAX_IMAGE_BYTES=4000000
SKETCHMIND_REPAIR_MAX_ROUNDS=2
SKETCHMIND_REPAIR_MAX_STEPS=12

# Model roles. Both fall back to SKETCHMIND_LLM_PROVIDER; either may name any
# registered provider and any model, and they need not agree on either.
# SKETCHMIND_TEXT_PROVIDER=azure-openai
# SKETCHMIND_TEXT_MODEL=gpt-4o-mini
# SKETCHMIND_VISION_PROVIDER=anthropic
# SKETCHMIND_VISION_MODEL=claude-sonnet-5
