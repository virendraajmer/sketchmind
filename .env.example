# SketchMind environment contract.
# Copy to .env and fill in. .env is gitignored -- never commit real values.

# ---- Azure OpenAI (AI Foundry) ----
# Read ONLY by packages/llm-provider-azure-openai. No other package may
# read these, or import an Azure SDK (lint-enforced).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# Verify the current GA API version for your deployment at implementation time --
# structured-output and tool-calling support vary by version and model.
AZURE_OPENAI_API_VERSION=<api-version>

# Optional: multimodal deployment for the VISUAL tier of self-correction
# (AD-3 / Phase 10b), where the agent looks at a rendered PNG of its own drawing.
#
# LEAVE BLANK. Blank is the supported default and costs nothing: self-correction
# still runs via the geometric tier (Phase 10a), which inspects the LayoutModel
# and StrokeAST as JSON -- deterministic, zero tokens, no added latency.
#
# Set this only when you decide the extra tokens and round-trip latency are worth
# catching what geometry inspection cannot ("this doesn't read as a pulley
# system"). Any deployment that accepts IMAGE INPUT works; the model only ever
# needs to output text. No code change is required to switch it on.
AZURE_OPENAI_VISION_DEPLOYMENT=

# Auth: use EITHER an API key OR Entra ID (managed identity / DefaultAzureCredential).
# Prefer Entra ID in deployed environments; the key is a local-dev convenience.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_USE_ENTRA_ID=false

# ---- Provider selection ----
# Changing this value is the ONLY change required to swap LLM providers.
# Supported: azure-openai | anthropic
SKETCHMIND_LLM_PROVIDER=azure-openai

# ---- Agent budgets ----
# These bound cost and liveness, never the agent's decisions (AD-8). The agent
# acts freely within them; they exist so a tool loop cannot run unbounded.
SKETCHMIND_AGENT_MAX_STEPS=40
SKETCHMIND_AGENT_MAX_TOKENS=200000
SKETCHMIND_AGENT_TIMEOUT_MS=180000

# ---- Servers ----
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
